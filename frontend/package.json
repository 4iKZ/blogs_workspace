{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "deps:check": "knip --dependencies",
    "check": "npm run type-check && npm run lint && npm run test && npm run deps:check && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "^1.6.8",
    "dompurify": "3.2.6",
    "echarts": "^6.0.0",
    "element-plus": "^2.7.6",
    "md-editor-v3": "^6.2.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@vue/test-utils": "2.4.11",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "knip": "^6.14.2",
    "typescript": "~5.2.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.2.0",
    "vitest": "3.2.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.0.6"
  }
