# 应用配置
spring:
  application:
    name: blog-backend
  
  # 数据源配置
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${DB_URL:jdbc:mysql://localhost:3306/blog_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}
    # 连接池配置
    hikari:
      minimum-idle: 5
      maximum-pool-size: 15
      auto-commit: true
      idle-timeout: 30000
      pool-name: BlogHikariCP
      max-lifetime: 1800000
      connection-timeout: 30000
      connection-test-query: SELECT 1
  
  # Redis配置
  redis:
    host: ${REDIS_HOST:localhost}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:}
    timeout: 5000ms
    database: 0
    lettuce:
      pool:
        max-active: 32
        max-wait: 3000ms
        max-idle: 16
        min-idle: 4

  # 邮箱配置
  mail:
    host: ${MAIL_HOST:smtp.163.com}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    from: ${MAIL_FROM:${MAIL_USERNAME:}}
    default-encoding: utf-8
    properties:
      mail:
        smtp:
          starttls:
            enable: true
            required: true
          ssl:
            enable: true
  
  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB
  
  # JSON配置
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8
    default-property-inclusion: non_null

# MyBatis Plus配置
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    cache-enabled: false
    call-setters-on-nulls: true
    jdbc-type-for-null: 'null'
    default-scripting-language: com.baomidou.mybatisplus.core.MybatisXMLLanguageDriver
  global-config:
    db-config:
      id-type: ASSIGN_ID
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
  type-aliases-package: com.blog.entity
  mapper-locations: classpath*:mapper/*.xml

# 日志配置
logging:
  level:
    com.blog: info
    com.blog.mapper: info
    org.springframework.security: info
    com.baomidou.mybatisplus: info
    org.apache.ibatis: info
    java.sql: info
    java.sql.Statement: info
    java.sql.PreparedStatement: info
    java.sql.ResultSet: info
  pattern:
    console: '%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx'
  file:
    name: logs/blog-backend.log
    max-size: 10MB
    max-history: 30

# JWT配置
jwt:
  secret: ${JWT_SECRET}
  refresh-secret: ${JWT_REFRESH_SECRET}
  access-expiration-seconds: 900
  refresh-expiration-seconds: 604800

security:
  refresh-cookie:
    secure: ${REFRESH_COOKIE_SECURE:true}
  password-reset:
    hmac-key: ${PASSWORD_RESET_HMAC_KEY}

app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:https://luminablog.cn}

# 文件上传配置
upload:
  image:
    max-dimension: 8192
    max-frame-pixels: 25000000
    max-total-pixels: 50000000
    max-gif-frames: 100
  path: /data/uploads/blog/
  max-size: 10485760 # 10MB
  allowed-types: jpg,jpeg,png,gif
  # 分片临时目录依赖SecureDirectoryStream；生产环境使用Linux/Unix文件系统。
  # Windows默认provider不支持该安全原语，分片上传会fail-closed。
  chunk:
    temp-dir: ${UPLOAD_CHUNK_TEMP_DIR:${java.io.tmpdir}/blog-uploads}

# 火山云TOS对象存储配置
tos:
  access-key-id: ${TOS_ACCESS_KEY_ID}
  secret-access-key: ${TOS_SECRET_ACCESS_KEY}
  endpoint: ${TOS_ENDPOINT:https://tos-cn-beijing.volces.com}
  region: ${TOS_REGION:cn-beijing}
  bucket-name: ${TOS_BUCKET_NAME}
  base-folder: ${TOS_BASE_FOLDER:old_book_system/}
  # ACL权限：public-read表示公开读取
  acl: public-read
  # 默认图片样式名称（在TOS控制台创建的样式）
  default-image-style: lumina

# GitHub OAuth配置
github:
  oauth:
    client-id: ${GITHUB_CLIENT_ID:}
    client-secret: ${GITHUB_CLIENT_SECRET:}
    redirect-uri: ${GITHUB_REDIRECT_URI:https://luminablog.cn/api/user/auth/github/callback}
    scope: read:user user:email

# 缓存配置
cache:
  # 本地缓存配置 (L1 Caffeine)
  local:
    enabled: true
    max-size: 1000
    default-ttl: 30s
    hot-articles-ttl: 30s
  # 缓存一致性配置
  consistency:
    enabled: true
    enable-double-delete: true
    enable-async-invalidation: true
    delayed-delete-ms: 1500
    enable-verification: true
    verification-interval-minutes: 5
    verification-sample-size: 100

# 分页配置
page:
  default-size: 10
  max-size: 100

# 服务器配置
server:
  port: 8080
  servlet:
    context-path: /
  tomcat:
    uri-encoding: UTF-8
